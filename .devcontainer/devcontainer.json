// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/docker-in-docker
{
	"name": "Case Study Game Dev Container",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	//"image": "mcr.microsoft.com/devcontainers/base:bullseye",
	"build": {
		"dockerfile": "../Dockerfile"
	},

	"features": {
		"ghcr.io/devcontainers/features/docker-in-docker:2": {
			"version": "latest",
			"enableNonRootDocker": "true",
			"moby": "true"
		},
		"ghcr.io/devcontainers/features/sshd:1": {
			"version": "latest"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [8000, 8888],
	"portsAttributes": {
		"8000": {
			"label": "MkDocs",
			"onAutoForward": "openBrowser"
		},
		"8888": {
			"label": "JupyterLab",
			"onAutoForward": "notify"
		}
	},

	// Use 'postCreateCommand' to run commands after the container is created.
	"postCreateCommand": "npm install && npm run setup:all",

	// コンテナの起動のたびに、ドキュメントのサーバー（MkDocs + PlantUML）を起動する。
	// mkdocs は plantuml に依存するので、両方が上がる。http://localhost:8000
	"postStartCommand": "docker compose up -d mkdocs",

	// Configure tool-specific properties.
  "customizations" : {
    "vscode" : {
      "extensions" : [
        "ms-python.python",
        "ms-python.vscode-python-envs",
        "ms-toolsai.jupyter"
      ],
      "settings" : {
        // 連載ごとに、Python のプロジェクトと、その .venv（npm run setup:* が作る）を割り当てる。
        // これで、テストの検出と実行が、各連載の .venv（pytest を含む）で動く。
        "python-envs.pythonProjects": [
          { "path": "apps/economics-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" },
          { "path": "apps/micro-basics-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" },
          { "path": "apps/macro-basics-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" },
          { "path": "apps/macro-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" },
          { "path": "apps/econometrics-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" },
          { "path": "apps/math-for-economics-programming/python", "envManager": "ms-python.python:venv", "packageManager": "ms-python.python:pip" }
        ],
        "python.testing.pytestEnabled": true,
        "python.testing.unittestEnabled": false
      }
    },
    "jetbrains" : {
      "backend" : "IntelliJ"
    }
  },

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	// "remoteUser": "root"
}
